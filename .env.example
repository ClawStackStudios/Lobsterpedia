# ─── Lobsterpedia Environment Configuration ─────────────────────────────────────
# Copy this file to .env and uncomment the desired settings.
# NEVER commit your .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── API Server URL ─────────────────────────────────────────────────────────────
# Required for connecting to the frontend
#
# Local Dev:        http://localhost:7575       (npm start / scuttle:dev-start)
# LAN/Self-Hosted:  http://[LOCAL-IP]:7575    (Replace IP with your machine's LAN IP)
# Docker:           Leave unset (uses relative paths, same-origin)
# Custom Domain:    https://wiki.yourdomain.com

VITE_API_URL=http://localhost:7575

# ── Security ──────────────────────────────────────────────────────────────────
# Enable "trust proxy" if the server is behind a trusted reverse proxy (e.g., Nginx, Docker, LB)
# This is required for correct IP detection when using rate limiting or HTTPS redirection.
# TRUST_PROXY=true

# ── CORS Configuration ────────────────────────────────────────────────────────
# Controls which origins can make requests to the API.
#
# LAN/Self-Hosted (default):
#   Leave unset — automatically allows any private IP (192.168.x.x, 10.x.x.x, localhost)
#   Works with docker-compose 0.0.0.0 binding
#
# Reverse Proxy / Cloudflare Tunnel:
#   Set to your public domain — only that origin is allowed
#   CORS_ORIGIN=https://wiki.yourdomain.com
#
# Multiple origins (comma-separated):
#   CORS_ORIGIN=https://wiki.yourdomain.com,http://localhost:4545
#
# CORS_ORIGIN=

# ── Data Storage ─────────────────────────────────────────────────────

# Sovereign Ledger (SQLite Geometric Reef Layer)
# Set to 'true' to activate the database layer.
# When active, all wiki page writes are mirrored into the ledger.
# The autoScanner will perform a Genesis Molt on first start.
# When false, the wiki is a pure filesystem reef (Manually Molted).
HATCH_DATABASE=false

# Path to the SQLite database file.
# Default: src/server/db/habitat.db (relative to project root)
# DB_PATH=./src/server/db/habitat.db──────────

# ── HTTPS / TLS (Optional) ─────────────────────────────────────────────────────
# Only needed if deploying to public internet WITHOUT a reverse proxy.
# For LAN deployments or behind CF tunnel/nginx, leave unset.
#
# ENFORCE_HTTPS=false
# HTTPS_PORT=7576

# ── Token Configuration ────────────────────────────────────────────────────────
# Default TTL for API tokens (in minutes). Default: 1440 (24 hours)
# TOKEN_TTL_DEFAULT=1440

# ── AI / OpenRouter ────────────────────────────────────────────────────────────
# Required for wiki synthesis and maintenance features.
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default model to use if not specified by user or ledger.
# Recommended: nousresearch/hermes-3-llama-3.1-405b:free
DEFAULT_OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b:free
VITE_DEFAULT_OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b:free

# ── Carapace Dreaming ──────────────────────────────────────────────────────────
# HATCH_CARAPACE: Master toggle for the Dreaming synthesis engine.
# IMPORTANT: Requires HATCH_DATABASE=true (neural substrate required for dreaming).
HATCH_CARAPACE=false

# CARAPACE_PATH: Directory for machine-synthesized insights.
# This should be a separate volume mount in Docker.
CARAPACE_PATH=./carapace

# CARAPACE_FREQUENCY: Frequency of dream sweeps (in milliseconds).
# Default: 3600000 (1 hour). Recommended: 3600000 to 86400000 (24h).
CARAPACE_FREQUENCY=3600000
