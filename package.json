  "type": "module",
  "scripts": {
    "dev": "HOST=127.0.0.1 tsx watch server.ts",
    "start": "tsx watch server.ts",
    "scuttle:dev-start": "HOST=127.0.0.1 PORT=7575 tsx watch server.ts",
    "scuttle:prod-start": "NODE_ENV=production npm run build && NODE_ENV=production HOST=0.0.0.0 PORT=7575 tsx server.ts",
