    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "scuttle:test": "vitest run",
    "test:report": "node scripts/test-reporter.js"
  },
